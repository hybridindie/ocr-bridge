# ocr-bridge review Job.
#
# Runs `ocr review` against a PR checkout and posts the findings back. Pin
# OCR_VERSION and the image tag together; the CLI is an npm package.
#
# trixie, not bookworm: OCR requires git >= 2.41 and bookworm ships 2.39, so a
# bookworm-based Job runs an unsupported git. trixie-slim carries 2.47 at a
# comparable size; the guard below fails the build if a future base downgrades
# git again.
FROM node:24.22.1-trixie-slim

ARG OCR_VERSION=1.14.4
ARG MIN_GIT_VERSION=2.41

# Only git + CA roots are needed on top of the Node base: the CLI is an npm
# launcher for a static binary, and `git` supplies the diff.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN dpkg --compare-versions "$(git --version | awk '{print $3}')" ge "${MIN_GIT_VERSION}" \
 || { echo "git $(git --version | awk '{print $3}') is older than the required ${MIN_GIT_VERSION}" >&2; exit 1; }

RUN npm install -g --no-audit --no-fund "@alibaba-group/open-code-review@${OCR_VERSION}" \
 && npm cache clean --force

ENV OCR_NO_UPDATE=1

COPY src/run-review.sh /usr/local/bin/run-review.sh
COPY src/post-review.mjs /usr/local/bin/post-review.mjs
RUN chmod +x /usr/local/bin/run-review.sh

# Optional stopgap, off by default: install git-shim.sh as /usr/local/bin/git
# (ahead of /usr/bin on PATH) so a literal pattern the model sent as PCRE is
# retried as -F. OCR 1.14.3 reports the regex error to the model itself, so
# this is only for images that want the older retry behaviour as well.
ARG GIT_SHIM=false
COPY src/git-shim.sh /usr/local/lib/ocr-bridge/git-shim.sh
RUN if [ "${GIT_SHIM}" = "true" ]; then \
      install -m 0755 /usr/local/lib/ocr-bridge/git-shim.sh /usr/local/bin/git \
      && [ "$(command -v git)" = /usr/local/bin/git ] && git --version; \
    fi

ENTRYPOINT ["/usr/local/bin/run-review.sh"]
